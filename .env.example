# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
#
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser and is NOT a secret.
# Everything else is server-only. Do not add NEXT_PUBLIC_ to a key below.
# ---------------------------------------------------------------------------

# App -----------------------------------------------------------------------
# Public origin of the deployed app. Used for invite links, widget script src,
# and the KB canonical URL. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase ------------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used exclusively by widget/webhook route handlers
# that must act on behalf of anonymous visitors. Never import into a client
# component.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> API -> JWT Settings -> JWT Secret.
# Used to sign short-lived visitor tokens so the widget can subscribe to its
# own Realtime channel without ever holding a Supabase key.
SUPABASE_JWT_SECRET=

# Email (Resend) ------------------------------------------------------------
RESEND_API_KEY=

# Resend -> Webhooks -> signing secret. Inbound webhooks are rejected without
# a valid signature.
RESEND_WEBHOOK_SECRET=

# The verified sending domain, e.g. help.yourdomain.com
EMAIL_DOMAIN=

# Address customers write to. Replies use plus-addressing off this mailbox
# (support+<conversation_token>@<domain>) as a threading fallback.
SUPPORT_EMAIL=

# AI (Google Gemini) --------------------------------------------------------
# aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# AI fallback (OpenRouter) ---------------------------------------------------
# Optional. If Gemini fails 3 times in a row (its free tier is quota-limited
# per day — see lib/ai/client.ts), a circuit breaker opens and summaries/
# drafts route to this instead for a cooldown window, rather than every
# request paying a 25s timeout to rediscover the same outage. Without this
# set, a Gemini outage falls back to the existing stale-cache/error behavior.
# openrouter.ai -> Keys. Default model below is free-tier; check
# openrouter.ai/models (filter: free) if it's been retired.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Custom domains (Vercel) ---------------------------------------------------
# Optional. Without these, domain connection degrades to "pending" and shows
# the DNS instructions instead of calling the Vercel API.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Only required if the project lives under a Vercel Team rather than a
# personal account.
VERCEL_TEAM_ID=

# Rate limiting (Upstash Redis) ----------------------------------------------
# Optional. Without these, lib/rate-limit.ts falls back to an in-memory
# sliding window scoped to a single serverless instance — a soft ceiling
# under real concurrency, not a hard one. With these set, every instance
# enforces the same shared, Redis-backed limit.
# upstash.com -> Create Database -> REST API section
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
