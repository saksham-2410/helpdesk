{
  "name": "superprofile-helpdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen",
    "check:sql": "node scripts/check-sql.mjs supabase/migrations/*.sql",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run check:sql && npm test",
    "build:widget": "node scripts/build-widget.mjs",
    "predev": "npm run build:widget",
    "prebuild": "npm run build:widget"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@supabase/realtime-js": "^2.111.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.4",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "libpg-query": "^17.7.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "description": "Customer communication platform — live chat, email, knowledge base, AI summarization"
}
